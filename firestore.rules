rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null && request.auth.token.email == "admin@techstore.com";
    }

    // Catálogo y equipo: lectura pública, escritura solo admin
    match /productos/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }
    match /equipo/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }
    // Cupones: lectura pública (para validar en el carrito), alta/baja solo admin
    match /cupones/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }
  }
}
